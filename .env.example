# Copy this to .env and fill in your Kalshi API credentials
# Get these from: Kalshi dashboard -> Settings -> API

KALSHI_API_KEY_ID=your_key_id_here
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# Trading mode: "paper" logs signals without executing, "live" executes real orders
TRADING_MODE=paper

# Max dollars risked per flip trade (hard cap regardless of Kelly)
MAX_TRADE_USD=20

# Bankroll in dollars (used for Kelly sizing)
BANKROLL=500
